# Copy this file to .env and fill in all values before running docker compose up

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_DB=vehiclechain
POSTGRES_USER=vehiclechain
POSTGRES_PASSWORD=change-me-strong-password

# ── Flask secrets (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-32-char-hex
JWT_SECRET_KEY=change-me-32-char-hex
KEYSTORE_PASSWORD=change-me-keystore-password
ADMIN_SECRET=change-me-admin-secret

# ── Blockchain ─────────────────────────────────────────────────────────────
GANACHE_URL=http://ganache:8545
CHAIN_ID=1337
VEHICLE_REGISTRY_ADDRESS=
SERVICE_LOG_ADDRESS=
WARRANTY_TRACKER_ADDRESS=
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# ── CORS / URLs ────────────────────────────────────────────────────────────
# Set to your hosted domain once deployed, e.g. https://myapp.up.railway.app
CORS_ORIGINS=http://localhost
FRONTEND_URL=http://localhost
USE_HTTPS=false

# ── Email (optional — set MAIL_SUPPRESS_SEND=true to disable) ─────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_SUPPRESS_SEND=true
